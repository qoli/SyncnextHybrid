+    func testURLSessionReaderCloseEndsItsBlockedBody() async throws {
+        let origin = try ProbeHTTPTestOrigin(data: Data(repeating: 0x47, count: 8192), stage: .body)
+        let url = URL(string: "http://127.0.0.1:\(origin.port)/media.bin")!
+        let reader = AVIOReader(url: url)
+        defer { reader.markClosed(); reader.close(); origin.stop() }
+        let open = ProbeTestJob { try reader.open() }
+        try await waitUntil { origin.blocked.entered }
+        reader.markClosed()
+        _ = try await open.outcome()
+        try await waitUntil { self.lines.values.contains { $0.contains("event=finished") && $0.contains("transport=avio-urlsession") } }
+        XCTAssertTrue(lines.values.contains { $0.contains("event=cancel-requested") && $0.contains("transport=avio-urlsession") })
+    }
+
+    func testRedirectedResourcesRetainTheirSourceIdentity() throws {
+        let source = URL(string: "https://origin.test/source?token=secret")!
+        let first = try XCTUnwrap(MediaRequestTrace(url: source, transport: "test"))
+        first.start()
+        let redirected = try XCTUnwrap(MediaRequestTrace(
+            url: URL(string: "https://cdn.test/object?credential=private"),
+            sourceURL: source, transport: "test"
+        ))
+        redirected.start()
+        let starts = lines.values.filter { $0.contains("event=started") }
+        func field(_ name: String, _ line: String) -> Substring? {
+            line.split(separator: " ").first { $0.hasPrefix(name + "=") }
+        }
+        XCTAssertEqual(field("sourceID", starts[0]), field("sourceID", starts[1]))
+        XCTAssertNotEqual(field("resourceID", starts[0]), field("resourceID", starts[1]))
+    }
+
+    private func waitUntil(_ predicate: () -> Bool) async throws {
+        let deadline = ContinuousClock.now + .seconds(20)
+        while !predicate() {
+            guard ContinuousClock.now < deadline else {
+                XCTFail("The controlled request did not reach the expected boundary")
+                throw URLError(.timedOut)
+            }
+            try await Task.sleep(for: .milliseconds(10))
+        }
+    }
+}
