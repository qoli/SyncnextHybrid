@@ -0,0 +1,105 @@
+import CryptoKit
+import Foundation
+
+/// Opt-in transport observations. Lines contain identifiers and byte counts,
+/// never request paths, queries, headers or response bodies.
+public enum MediaRequestDiagnostics {
+    private static let lock = NSLock()
+    nonisolated(unsafe) private static var sink: (@Sendable (String) -> Void)?
+
+    public static var handler: (@Sendable (String) -> Void)? {
+        get { lock.withLock { sink } }
+        set { lock.withLock { sink = newValue } }
+    }
+}
+
+/// Owned by the transfer, so late deliveries remain visible after its reader
+/// and playback session have been detached. This object owns no network work.
+final class MediaRequestTrace: @unchecked Sendable {
+    private let lock = NSLock()
+    private let sink: @Sendable (String) -> Void
+    private let identity: String
+    private var sequence = 0
+    private var bytes: Int64 = 0
+    private var reportedBytes: Int64 = 0
+    private var cancelledAtBytes: Int64?
+    private var lastProgressAt: TimeInterval?
+    private var finished = false
+    private var started = false
+
+    init?(url: URL?, sourceURL: URL? = nil, transport: String, range: String? = nil) {
+        guard let url, let sink = MediaRequestDiagnostics.handler else { return nil }
+        self.sink = sink
+        let sourceID = SHA256.hash(data: Data((sourceURL ?? url).absoluteString.utf8))
+            .map { String(format: "%02x", $0) }.joined()
+        let resourceID = SHA256.hash(data: Data(url.absoluteString.utf8))
+            .map { String(format: "%02x", $0) }.joined()
+        // Range is generated by our transports; do not accept arbitrary headers.
+        let safeRange = range.flatMap { value in
+            value.allSatisfy { "bytes=0123456789- ,".contains($0) } ? value : nil
+        }?.replacingOccurrences(of: " ", with: "") ?? "none"
+        identity = "request=\(UUID().uuidString) sourceID=\(sourceID)"
+            + " resourceID=\(resourceID)"
+            + " transport=\(transport) range=\(safeRange)"
+    }
+
+    func start() {
+        emit { _ in
+            guard !self.started else { return nil }
+            self.started = true
+            return "started"
+        }
+    }
+
+    func response(_ response: HTTPURLResponse) {
+        emit { _ in "response status=\(response.statusCode)" }
+    }
+
+    func receive(_ count: Int) {
+        emit { now in
+            self.bytes += Int64(count)
+            let firstAfterCancel = self.cancelledAtBytes.map { self.reportedBytes <= $0 } ?? false
+            // Coalesce high-frequency body callbacks, but always expose the
+            // first byte and the first delivery after a cancellation request.
+            let progressDue = self.lastProgressAt.map { now - $0 >= 1 } ?? true
+            guard progressDue || firstAfterCancel || self.finished else { return nil }
+            self.lastProgressAt = now
+            return "progress"
+        }
+    }
+
+    func cancel() {
+        emit { _ in
+            guard self.cancelledAtBytes == nil, !self.finished else { return nil }
+            self.cancelledAtBytes = self.bytes
+            return "cancel-requested"
+        }
+    }
+
+    func finish(error: Error? = nil) {
+        emit { _ in
+            guard !self.finished else { return nil }
+            self.finished = true
+            let failure = error as NSError?
+            // Only the numeric code is needed to distinguish URL cancellation
+            // from completion; localized errors can contain replayable URLs.
+            return "finished errorCode=\(failure?.code ?? 0)"
+        }
+    }
+
+    private func emit(_ update: (TimeInterval) -> String?) {
+        let line: String? = lock.withLock {
+            let now = ProcessInfo.processInfo.systemUptime
+            guard let event = update(now) else { return nil }
+            sequence += 1
+            let delta = bytes - reportedBytes
+            reportedBytes = bytes
+            let afterCancel = cancelledAtBytes.map { bytes - $0 } ?? 0
+            return "MEDIA_REQUEST event=\(event) \(identity) seq=\(sequence)"
+                + " uptimeMs=\(Int64(now * 1_000)) bytes=\(bytes) deltaBytes=\(delta)"
+                + " cancelRequested=\(cancelledAtBytes != nil) afterCancelBytes=\(afterCancel)"
+                + " finished=\(finished)"
+        }
+        if let line { sink(line) }
+    }
+}
