+final class MediaRequestDiagnosticsTests: XCTestCase {
+    private final class Lines: @unchecked Sendable {
+        private let lock = NSLock()
+        private var storage: [String] = []
+        func append(_ line: String) { lock.withLock { storage.append(line) } }
+        var values: [String] { lock.withLock { storage } }
+    }
+
+    private var previous: (@Sendable (String) -> Void)?
+    private let lines = Lines()
+
+    override func setUp() {
+        super.setUp()
+        previous = MediaRequestDiagnostics.handler
+        let lines = lines
+        MediaRequestDiagnostics.handler = { lines.append($0) }
+    }
+
+    override func tearDown() {
+        MediaRequestDiagnostics.handler = previous
+        super.tearDown()
+    }
+
+    func testLateBytesAreCountedAndCredentialsAreNeverLogged() throws {
+        let trace = try XCTUnwrap(MediaRequestTrace(
+            url: URL(string: "https://user:password@example.test/private/movie.mkv?token=secret"),
+            transport: "test", range: "bytes=16-"
+        ))
+        trace.start()
+        trace.receive(100)
+        trace.cancel()
+        trace.receive(17)
+        trace.finish(error: URLError(.cancelled))
+        trace.finish()
+        XCTAssertTrue(lines.values.contains { $0.contains("event=progress") && $0.contains("afterCancelBytes=17") })
+        XCTAssertEqual(lines.values.filter { $0.contains("event=finished") }.count, 1)
+        let finish = try XCTUnwrap(lines.values.last)
+        XCTAssertTrue(finish.contains("bytes=117"))
+        XCTAssertTrue(finish.contains("errorCode=-999"))
+        XCTAssertTrue(finish.contains("finished=true"))
+        for secret in ["password", "private", "movie.mkv", "token", "secret", "example.test"] {
+            XCTAssertFalse(lines.values.joined().contains(secret))
+        }
+    }
+
+    func testHeldSourceCloseEndsARequestWhoseBodyNeverArrived() async throws {
+        let origin = try ProbeHTTPTestOrigin(data: Data(repeating: 0x47, count: 8192), stage: .body, stallOpenEndedBody: true)
+        let url = URL(string: "http://127.0.0.1:\(origin.port)/media.bin")!
+        let reader = AVIOReader(url: url, heldConnection: true)
+        defer { reader.markClosed(); reader.close(); origin.stop() }
+        let open = ProbeTestJob { try reader.open() }
+        try await waitUntil { origin.blocked.entered }
+        reader.markClosed()
+        _ = try await open.outcome()
+        try await waitUntil { self.lines.values.contains { $0.contains("event=finished") } }
+        XCTAssertTrue(lines.values.contains { $0.contains("transport=avio-held-http1") && $0.contains("event=cancel-requested") })
+        XCTAssertTrue(lines.values.contains { $0.contains("event=finished") && $0.contains("bytes=0") })
+        XCTAssertFalse(lines.values.contains { $0.contains("event=progress") })
+    }
+
+    func testHLSURLSessionCancellationReachesTheActualTaskCompletion() async throws {
+        let origin = try ProbeHTTPTestOrigin(data: Data(repeating: 0x47, count: 8192), stage: .body)
+        let url = URL(string: "http://127.0.0.1:\(origin.port)/segment.ts")!
+        let session = URLSession(configuration: .ephemeral)
+        defer { session.invalidateAndCancel(); origin.stop() }
+        var rangeRequest = URLRequest(url: url)
+        rangeRequest.setValue("bytes=0-8191", forHTTPHeaderField: "Range")
+        let requestInput = rangeRequest
+        let request = Task {
+            try await BoundedFetch.data(for: requestInput, session: session, limit: 16384)
+        }
+        try await waitUntil { origin.blocked.entered }
+        request.cancel()
+        do {
+            _ = try await request.value
+            XCTFail("A cancelled media request must not return a completed body")
+        } catch {}
+        XCTAssertTrue(lines.values.contains { $0.contains("event=finished") && $0.contains("transport=hls-urlsession") && $0.contains("cancelRequested=true") })
+        let pending = await session.allTasks
+        XCTAssertTrue(pending.isEmpty)
+    }
+
+    func testPersistentHLSCloseReportsThePendingRequestAsCancelled() async throws {
+        let origin = try ProbeHTTPTestOrigin(data: Data(repeating: 0x47, count: 8192), stage: .headers)
+        let url = URL(string: "http://127.0.0.1:\(origin.port)/segment.ts")!
+        let transport = PersistentHTTP1Transport(label: "media-diagnostics-tests")
+        defer { transport.close(); origin.stop() }
+        let request = Task { try await transport.open(url, headers: [:], limit: 16384) }
+        try await waitUntil { origin.blocked.entered }
+        transport.close()
+        _ = await request.result
+        XCTAssertTrue(lines.values.contains { $0.contains("event=cancel-requested") && $0.contains("transport=hls-held-http1") })
+        XCTAssertTrue(lines.values.contains { $0.contains("event=finished") && $0.contains("transport=hls-held-http1") && $0.contains("bytes=0") })
+    }
