@@ -100,10 +100,51 @@ struct HTTPDiscIOReaderTests {
 
     private static let streamStart = 64 * 1024
 
+    @Test("discovery and independent profiles retain adaptive ranges until playback admission")
+    func unadmittedReaderDoesNotStream() throws {
+        let src = (0..<(4 << 20)).map { UInt8(truncatingIfNeeded: $0 &* 17) }
+        let maximum = 512 * 1024
+        let reader = try #require(makeReader(src, base: 64 * 1024, maxChunk: maximum, streamRange: 1024 * 1024))
+        defer { reader.close() }
+        let bytes = readAll(reader, count: 2 * 1024 * 1024)
+        #expect(bytes == Array(src[0..<bytes.count]))
+        let oversized = MockRangeURLProtocol.requestedRanges.filter { range in
+            let ends = range.replacingOccurrences(of: "bytes=", with: "").split(separator: "-").compactMap { Int($0) }
+            return ends.count == 2 && ends[1] - ends[0] + 1 > maximum
+        }
+        #expect(oversized.isEmpty, "unadmitted reader issued progressive ranges: \(oversized)")
+    }
+
+    @Test("playback enables long sequential ranges before the adaptive ceiling and reopens after a seek")
+    func playbackRangeAdmission() throws {
+        let src = (0..<(2 << 20)).map { UInt8(truncatingIfNeeded: $0 &* 7) }
+        let base = 64 * 1024
+        let long = 1024 * 1024
+        let r = try #require(makeReader(src, base: base, maxChunk: 512 * 1024, streamRange: long))
+        defer { r.close() }
+
+        #expect(readOffThread(r, size: base, within: 5)?.n == Int32(base))
+        #expect(readOffThread(r, size: 2 * base, within: 5)?.n == Int32(2 * base))
+        #expect(MockRangeURLProtocol.requestedRanges.last == HTTPDiscIOReader.rangeHeader(offset: Int64(base), length: 2 * base))
+
+        r.enableProgressiveReadAhead()
+        let start = 3 * base
+        let streamed = try #require(readOffThread(r, size: base, within: 5))
+        #expect(streamed.bytes == Array(src[start..<(start + base)]))
+        #expect(MockRangeURLProtocol.requestedRanges.contains(HTTPDiscIOReader.rangeHeader(offset: Int64(start), length: long)))
+
+        let target = Int64(start + base + 512)
+        #expect(r.seek(offset: target, whence: SEEK_SET) == target)
+        let sought = try #require(readOffThread(r, size: base, within: 5))
+        #expect(sought.bytes == Array(src[Int(target)..<(Int(target) + base)]))
+        #expect(MockRangeURLProtocol.requestedRanges.last == HTTPDiscIOReader.rangeHeader(offset: target, length: base))
+    }
+
