+
+    @Test("progressive disc range delivers before its tail arrives and is discarded on seek",
+          .timeLimit(.minutes(3)))
+    func progressiveDeliveryAndSeek() throws {
+        let chunk = 64 * 1024
+        let sequentialStart = Int64(chunk)
+        let origin = ThrottledOriginServer(totalSize: total, patternedBody: true, respond: { _, offset, _ in
+            offset == sequentialStart ? .serveThenGoSilent(afterBytes: 32 * 1024) : .serve206
+        })
+        let server = try #require(origin)
+        defer { server.stop() }
+        let reader = try #require(HTTPDiscIOReader(
+            url: url(server), baseChunkSize: chunk, requestTimeout: 2
+        ))
+        defer { reader.close() }
+
+        try #require(read(reader, at: 0, count: chunk) != nil)
+        #expect(server.requestedRanges.last?.end == sequentialStart - 1)
+        reader.enableProgressiveReadAhead()
+        let first = (0..<4096).map { ThrottledOriginServer.patternByte(at: sequentialStart + Int64($0)) }
+        #expect(read(reader, at: sequentialStart, count: first.count) == first)
+        #expect(server.requestedRanges.last?.end == sequentialStart + 64 * 1024 * 1024 - 1)
+
+        let target: Int64 = 9_000_000
+        let seekBytes = (0..<4096).map { ThrottledOriginServer.patternByte(at: target + Int64($0)) }
+        #expect(read(reader, at: target, count: seekBytes.count) == seekBytes)
+        #expect(server.requestedRanges.last?.start == target)
+        #expect(server.requestedRanges.last?.end == target + Int64(chunk) - 1)
+    }
+
