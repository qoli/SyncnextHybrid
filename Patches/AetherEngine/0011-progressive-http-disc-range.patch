+        let sought = try #require(readOffThread(r, size: base, within: 5))
+        #expect(sought.bytes == Array(src[Int(target)..<(Int(target) + base)]))
+        #expect(MockRangeURLProtocol.requestedRanges.last == HTTPDiscIOReader.rangeHeader(offset: target, length: base))
+    }
