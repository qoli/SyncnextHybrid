+    /// A response type is a probe hint; DiscReader still validates the actual filesystem.
+    static func isDiscImageContentType(_ value: String?) -> Bool {
+        normalizedContentType(value) == "application/x-iso9660-image"
+    }
+
+    private static func normalizedContentType(_ value: String?) -> String? {
+        value?.split(separator: ";", maxSplits: 1).first?
+            .trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+    }
+
+    private func hasHTTPDiscHint(_ reader: AVIOReader) throws -> Bool {
+        if Self.isDiscImageContentType(reader.responseContentType) { return true }
+        guard Self.normalizedContentType(reader.responseContentType) == "application/octet-stream",
+              let context = reader.context, context.pointee.seekable != 0 else { return false }
+
+        // A generic MIME carries no format evidence. Read the first volume descriptor from the
+        // existing response, then rewind inside AVIO's opening buffer so ordinary media keeps
+        // its original bytes and incurs no separate HEAD or Range request. ISO9660 and UDF's
+        // volume-recognition sequence begin after the 16-sector system area.
+        let descriptorOffset = 16 * 2048
+        var prefix = [UInt8](repeating: 0, count: descriptorOffset + 7)
+        let count = prefix.withUnsafeMutableBufferPointer {
+            avio_read(context, $0.baseAddress, Int32($0.count))
+        }
+        guard count >= 0 else { throw DemuxerError.openFailed(code: count) }
+        let rewound = avio_seek(context, 0, SEEK_SET)
+        guard rewound == 0 else { throw DemuxerError.openFailed(code: Int32(rewound)) }
+        guard count == prefix.count, prefix[descriptorOffset + 6] == 1 else { return false }
+        let identifier = String(decoding: prefix[(descriptorOffset + 1)..<(descriptorOffset + 6)], as: UTF8.self)
+        return ["CD001", "BEA01", "NSR02", "NSR03"].contains(identifier)
+    }
