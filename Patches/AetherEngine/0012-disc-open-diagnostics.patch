diff --git a/Sources/AetherEngine/Diagnostics/DiscOpenTrace.swift b/Sources/AetherEngine/Diagnostics/DiscOpenTrace.swift
new file mode 100644
index 00000000..bca2326d
--- /dev/null
+++ b/Sources/AetherEngine/Diagnostics/DiscOpenTrace.swift
@@ -0,0 +1,11 @@
+import Foundation
+
+/// Opt-in disc-opening trace. Thread and monotonic time distinguish concurrent demuxers.
+enum DiscOpenTrace {
+    static let enabled = ProcessInfo.processInfo.arguments.contains("--aether-disc-open-trace")
+
+    static func mark(_ fields: @autoclosure () -> String) {
+        guard enabled else { return }
+        EngineLog.emit("[DiscOpenTrace] time=\(ProcessInfo.processInfo.systemUptime) thread=\(pthread_mach_thread_np(pthread_self())) \(fields())", category: .demux)
+    }
+}
