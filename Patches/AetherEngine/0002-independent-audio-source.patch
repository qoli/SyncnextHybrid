+++ b/Sources/AetherEngine/AetherEngine+IndependentAudioSource.swift
@@ -0,0 +1,240 @@
+import AVFoundation
+import Foundation
+
+/// Stable, non-AVFoundation description of the audible option selected by a
+/// probe-free native HLS item.
+public struct AetherRemoteHLSAudioSelection: Sendable, Equatable {
+    public let displayName: String?
+    public let language: String?
+    public let optionOrdinal: Int?
+
+    public init(
+        displayName: String?,
+        language: String?,
+        optionOrdinal: Int?
+    ) {
+        self.displayName = displayName
+        self.language = language
+        self.optionOrdinal = optionOrdinal
+    }
+}
+
+/// Everything middleware needs to prepare an independent finite HLS VOD
+/// cursor. The request contains no AVPlayer or AVMediaSelectionOption objects.
+public struct AetherRemoteHLSAudioRequest: Sendable, Equatable {
+    public let url: URL
+    public let httpHeaders: [String: String]
+    public let selection: AetherRemoteHLSAudioSelection
+
+    public init(
+        url: URL,
+        httpHeaders: [String: String],
+        selection: AetherRemoteHLSAudioSelection
+    ) {
+        self.url = url
+        self.httpHeaders = httpHeaders
+        self.selection = selection
+    }
+}
+
+public enum AetherIndependentAudioSelection: Sendable, Equatable {
+    case ffmpeg(TrackInfo)
+    case remoteHLS(AetherRemoteHLSAudioSelection)
+}
+
+/// Stable source facts captured from one loaded AetherEngine session.
+///
+/// The value can create a fresh demuxer, but never exposes or reuses the
+/// playback cursor. Hybrid owns decoding, resampling, back-pressure, and
+/// cancellation after it receives this source.
+public struct AetherIndependentAudioSource: @unchecked Sendable {
+    public enum Kind: Sendable, Equatable {
+        case url
+        case custom
+        case remoteHLS
+    }
+
+    public let kind: Kind
+    public let durationSeconds: Double
+    public let isSeekable: Bool
+    public let selection: AetherIndependentAudioSelection
+
+    public var selectedAudioTrack: TrackInfo? {
+        guard case .ffmpeg(let track) = selection else {
+            return nil
+        }
+        return track
+    }
+
+    public var remoteHLSRequest: AetherRemoteHLSAudioRequest? {
+        guard case .remoteHLS(let request) = backing else {
+            return nil
+        }
+        return request
+    }
+
+    fileprivate enum Backing {
+        case url(URL, headers: [String: String])
+        case custom(IOReader, formatHint: String?)
+        case remoteHLS(AetherRemoteHLSAudioRequest)
+    }
+
+    private let backing: Backing
+
+    fileprivate init(
+        backing: Backing,
+        durationSeconds: Double,
+        isSeekable: Bool,
+        selection: AetherIndependentAudioSelection
+    ) {
+        self.backing = backing
+        self.kind = {
+            switch backing {
+            case .url: .url
+            case .custom: .custom
+            case .remoteHLS: .remoteHLS
+            }
+        }()
+        self.durationSeconds = durationSeconds
+        self.isSeekable = isSeekable
+        self.selection = selection
+    }
+
+    /// Opens a caller-owned demuxer. Supplying the instance first lets the
+    /// caller make cancellation visible before a network open begins.
+    public func openDemuxer(_ demuxer: Demuxer) throws {
+        guard isSeekable else {
+            throw AetherIndependentAudioSourceError.sourceNotSeekable
+        }
+
+        do {
+            switch backing {
+            case .url(let url, let headers):
+                try demuxer.openIndependent(url: url, extraHeaders: headers)
+            case .custom(let reader, let formatHint):
+                guard let independent = reader.makeIndependentReader() else {
+                    throw AetherIndependentAudioSourceError.independentReaderUnavailable
+                }
+                try demuxer.openIndependent(reader: independent, formatHint: formatHint)
+            case .remoteHLS:
+                throw AetherIndependentAudioSourceError.remoteHLSPreparationRequired
+            }
+        } catch {
+            demuxer.close()
+            throw error
+        }
+        guard demuxer.isSourceSeekable else {
+            demuxer.close()
+            throw AetherIndependentAudioSourceError.sourceNotSeekable
+        }
+    }
+
+    /// Convenience for clients that do not need to register cancellation
+    /// before open.
+    public func makeDemuxer() throws -> Demuxer {
+        let demuxer = Demuxer()
+        try openDemuxer(demuxer)
+        return demuxer
+    }
+}
+
+public enum AetherIndependentAudioSourceError: Error, Sendable, Equatable {
+    case noActiveSession
+    case liveOrDVRUnsupported
+    case sourceNotSeekable
+    case selectedAudioTrackUnavailable
+    case independentReaderUnavailable
+    case remoteHLSPreparationRequired
+}
+
+public extension AetherEngine {
+    /// Snapshots the active source and selected FFmpeg audio stream identity.
+    /// Probe-free native HLS snapshots a stable media-selection description;
+    /// Hybrid resolves it to one FFmpeg stream in an independent VOD cursor.
+    func independentAudioSource() throws -> AetherIndependentAudioSource {
+        switch state {
+        case .idle, .error:
+            throw AetherIndependentAudioSourceError.noActiveSession
+        case .loading, .playing, .paused, .seeking, .ended:
+            break
+        }
+        guard !isLive, !loadedOptions.isLive else {
+            throw AetherIndependentAudioSourceError.liveOrDVRUnsupported
+        }
+        if loadedOptions.nativeRemoteHLS {
+            guard duration.isFinite, duration > 0,
+                  let loadedURL else {
+                throw AetherIndependentAudioSourceError.sourceNotSeekable
+            }
+            let selected = remoteHLSAudioSelection()
+            let request = AetherRemoteHLSAudioRequest(
+                url: loadedURL,
+                httpHeaders: loadedOptions.httpHeaders,
+                selection: selected
+            )
+            return AetherIndependentAudioSource(
+                backing: .remoteHLS(request),
+                durationSeconds: duration,
+                isSeekable: true,
+                selection: .remoteHLS(selected)
+            )
+        }
+        guard loadedSourceIsSeekable else {
+            throw AetherIndependentAudioSourceError.sourceNotSeekable
+        }
+        guard let selectedID = activeAudioTrackIndex,
+              let selectedTrack = audioTracks.first(where: { $0.id == selectedID }) else {
+            throw AetherIndependentAudioSourceError.selectedAudioTrackUnavailable
+        }
+
+        let backing: AetherIndependentAudioSource.Backing
+        if isCustomSource {
+            guard let customReader else {
+                throw AetherIndependentAudioSourceError.noActiveSession
+            }
+            backing = .custom(customReader, formatHint: customFormatHint)
+        } else {
+            guard let loadedURL else {
+                throw AetherIndependentAudioSourceError.noActiveSession
+            }
+            backing = .url(loadedURL, headers: loadedOptions.httpHeaders)
+        }
+
+        return AetherIndependentAudioSource(
+            backing: backing,
+            durationSeconds: duration,
+            isSeekable: loadedSourceIsSeekable,
+            selection: .ffmpeg(selectedTrack)
+        )
+    }
+
+    private func remoteHLSAudioSelection()
+        -> AetherRemoteHLSAudioSelection
+    {
+        guard let item = currentAVPlayer?.currentItem,
+              let group = item.asset.mediaSelectionGroup(
+                forMediaCharacteristic: .audible
+              ) else {
+            return AetherRemoteHLSAudioSelection(
+                displayName: nil,
+                language: nil,
+                optionOrdinal: nil
+            )
+        }
+        let option =
+            item.currentMediaSelection.selectedMediaOption(in: group)
+            ?? group.defaultOption
+        let ordinal = option.flatMap { selected in
+            group.options.firstIndex { candidate in
+                candidate === selected || candidate.isEqual(selected)
+            }
+        }
+        return AetherRemoteHLSAudioSelection(
+            displayName: option?.displayName,
+            language:
+                option?.extendedLanguageTag
+                ?? option?.locale?.identifier,
+            optionOrdinal: ordinal
+        )
+    }
+}
