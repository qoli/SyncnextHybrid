index 00000000..f75f4d4f
--- /dev/null
+++ b/Sources/AetherEngine/AetherEngine+FingerprintAudio.swift
@@ -0,0 +1,339 @@
+import Foundation
+import AVFAudio
+
+/// One finite, cache-backed PCM result intended only for fingerprint analysis.
+/// Buffers use `AetherEngine.audioTapFormat` and carry source-axis timestamps.
+public struct AetherFingerprintAudioBatch: @unchecked Sendable {
+    public let buffers: [AudioTapBuffer]
+    public let sourceRange: Range<Double>
+    public let segmentCount: Int
+    public let cacheWaitSeconds: Double
+    public let decodeSeconds: Double
+}
+
+public enum AetherFingerprintAudioError: Error, Sendable, Equatable {
+    case invalidRange
+    case loopbackVODRequired
+    case audioTrackUnavailable
+    case sourceAxisUnavailable
+    case segmentUnavailable(Int)
+    case segmentTimelineUnavailable(Int)
+    case segmentDecodeFailed(Int)
+    case discontinuousRange
+    case incompleteRange
+    case sessionChanged
+}
+
+extension AetherEngine {
+
+    /// Decode a bounded source-time range from the active loopback VOD cache as
+    /// fast as segments become available. Unlike `installAudioTap()`, this is a
+    /// one-shot batch operation and is not paced to the playhead. It never opens
+    /// another source URL or silently switches to the remote-HLS tap reader.
+    @MainActor
+    public func fingerprintAudio(
+        in sourceRange: Range<Double>,
+        timeoutSeconds: Double = 30
+    ) async throws -> AetherFingerprintAudioBatch {
+        let duration = sourceRange.upperBound - sourceRange.lowerBound
+        guard sourceRange.lowerBound.isFinite,
+              sourceRange.upperBound.isFinite,
+              sourceRange.lowerBound >= 0,
+              duration > 0,
+              duration <= 180,
+              timeoutSeconds.isFinite,
+              timeoutSeconds > 0 else {
+            throw AetherFingerprintAudioError.invalidRange
+        }
+        guard !isLive,
+              let session = nativeVideoSession,
+              let cache = session.cache,
+              let provider = session.provider else {
+            throw AetherFingerprintAudioError.loopbackVODRequired
+        }
+        guard session.audioPipelineDescription != nil else {
+            throw AetherFingerprintAudioError.audioTrackUnavailable
+        }
+
+        let generation = loadGeneration
+        let presentationOrigin = sourcePresentationOrigin
+        let axisMap = presentationAxisMap
+        guard let itemRange = FingerprintAudioAxis.itemRange(
+            for: sourceRange,
+            sourcePresentationOrigin: presentationOrigin,
+            map: axisMap
+        ) else {
+            throw AetherFingerprintAudioError.sourceAxisUnavailable
+        }
+        let firstIndex = provider.segmentIndex(
+            forPlaylistTime: itemRange.lowerBound
+        )
+        let lastIndex = provider.segmentIndex(
+            forPlaylistTime: max(
+                itemRange.lowerBound,
+                itemRange.upperBound - 0.000_001
+            )
+        )
+        let maximumLastIndex = lastIndex == Int.max
+            ? lastIndex
+            : lastIndex + 1
+        let reader = CachedFingerprintAudioReader(
+            cache: cache,
+            firstIndex: firstIndex,
+            nominalLastIndex: lastIndex,
+            maximumLastIndex: maximumLastIndex,
+            sourceRange: sourceRange,
+            sourcePresentationOrigin: presentationOrigin,
+            timeoutSeconds: timeoutSeconds
+        )
+        let startedAt = ProcessInfo.processInfo.systemUptime
+        EngineLog.emit(
+            "[FingerprintAudio] phase=started range="
+                + "\(String(format: "%.3f", sourceRange.lowerBound))..."
+                + "\(String(format: "%.3f", sourceRange.upperBound)) "
+                + "itemRange=\(String(format: "%.3f", itemRange.lowerBound))..."
+                + "\(String(format: "%.3f", itemRange.upperBound)) "
+                + "segments=\(firstIndex)...\(lastIndex) "
+                + "lookaheadThrough=\(maximumLastIndex)",
+            category: .engine
+        )
+        let worker = Task.detached(priority: .utility) {
+            try reader.read()
+        }
+        do {
+            let batch = try await withTaskCancellationHandler {
+                try await worker.value
+            } onCancel: {
+                worker.cancel()
+                cache.wakeWaiters()
+            }
+            guard loadGeneration == generation,
+                  nativeVideoSession === session,
+                  FingerprintAudioAxis.itemRange(
+                    for: sourceRange,
+                    sourcePresentationOrigin: sourcePresentationOrigin,
+                    map: presentationAxisMap
+                  ) == itemRange else {
+                throw AetherFingerprintAudioError.sessionChanged
+            }
+            EngineLog.emit(
+                "[FingerprintAudio] phase=completed range="
+                    + "\(String(format: "%.3f", sourceRange.lowerBound))..."
+                    + "\(String(format: "%.3f", sourceRange.upperBound)) "
+                    + "segments=\(batch.segmentCount) "
+                    + "cacheWait=\(String(format: "%.3f", batch.cacheWaitSeconds)) "
+                    + "decode=\(String(format: "%.3f", batch.decodeSeconds)) "
+                    + "elapsed=\(String(format: "%.3f", ProcessInfo.processInfo.systemUptime - startedAt))",
+                category: .engine
+            )
+            return batch
+        } catch {
+            if loadGeneration != generation || nativeVideoSession !== session {
+                throw AetherFingerprintAudioError.sessionChanged
+            }
+            throw error
+        }
+    }
+}
+
+private final class CachedFingerprintAudioReader: @unchecked Sendable {
+    private let cache: SegmentCache
+    private let firstIndex: Int
+    private let nominalLastIndex: Int
+    private let maximumLastIndex: Int
+    private let sourceRange: Range<Double>
+    private let sourcePresentationOrigin: Double
+    private let timeoutSeconds: Double
+    private let decoder = AudioTapSegmentDecoder()
+
+    init(
+        cache: SegmentCache,
+        firstIndex: Int,
+        nominalLastIndex: Int,
+        maximumLastIndex: Int,
+        sourceRange: Range<Double>,
+        sourcePresentationOrigin: Double,
+        timeoutSeconds: Double
+    ) {
+        self.cache = cache
+        self.firstIndex = firstIndex
+        self.nominalLastIndex = nominalLastIndex
+        self.maximumLastIndex = maximumLastIndex
+        self.sourceRange = sourceRange
+        self.sourcePresentationOrigin = sourcePresentationOrigin
+        self.timeoutSeconds = timeoutSeconds
+    }
+
+    func read() throws -> AetherFingerprintAudioBatch {
+        let deadline = Date().addingTimeInterval(timeoutSeconds)
+        let demand = cache.beginAnalysisDemand(through: maximumLastIndex)
+        defer { cache.endAnalysisDemand(demand) }
+
+        let collector = FingerprintAudioCollector()
+        let filter = AudioTapMonotonicFilter { buffer in
+            collector.append(buffer)
+        }
+        var pendingDiscontinuity = true
+        var cacheWaitSeconds = 0.0
+        var decodeSeconds = 0.0
+        var lastDecodedIndex = firstIndex - 1
+
+        for index in firstIndex...maximumLastIndex {
+            try Task.checkCancellation()
+            let waitStartedAt = ProcessInfo.processInfo.systemUptime
+            guard let segment = try waitForSegment(index, deadline: deadline) else {
+                throw AetherFingerprintAudioError.segmentUnavailable(index)
+            }
+            guard let audioSourceShiftSeconds = segment.audioSourceShiftSeconds else {
+                throw AetherFingerprintAudioError.segmentTimelineUnavailable(index)
+            }
+            cacheWaitSeconds +=
+                ProcessInfo.processInfo.systemUptime - waitStartedAt
+
+            let version = cache.initVersionID(forSegment: index)
+            guard let initData = cache.initData(versionID: version)
+                    ?? cache.fetchInit(timeout: remaining(until: deadline)) else {
+                throw AetherFingerprintAudioError.segmentUnavailable(index)
+            }
+            let decodeStartedAt = ProcessInfo.processInfo.systemUptime
+            let chunks = decoder.decode(initData: initData, segment: segment.data)
+            decodeSeconds += ProcessInfo.processInfo.systemUptime - decodeStartedAt
+            guard !chunks.isEmpty else {
+                throw AetherFingerprintAudioError.segmentDecodeFailed(index)
+            }
+            for chunk in chunks {
+                filter.accept(
+                    AudioTapBuffer(
+                        buffer: chunk.buffer,
+                        sourceTime: FingerprintAudioTimeline.sourceTime(
+                            decodedPTS: chunk.ptsSeconds,
+                            audioSourceShiftSeconds: audioSourceShiftSeconds,
+                            sourcePresentationOrigin: sourcePresentationOrigin
+                        ),
+                        discontinuity: pendingDiscontinuity
+                    )
+                )
+                pendingDiscontinuity = false
+            }
+            lastDecodedIndex = index
+            if index >= nominalLastIndex,
+               coversRequestedEnd(collector.snapshot()) {
+                break
+            }
+        }
+
+        let relevant = collector.snapshot().filter { buffer in
+            let end = buffer.sourceTime
+                + Double(buffer.buffer.frameLength)
+                    / buffer.buffer.format.sampleRate
+            return end > sourceRange.lowerBound
+                && buffer.sourceTime < sourceRange.upperBound
+        }
+        try validateCoverage(relevant)
+        return AetherFingerprintAudioBatch(
+            buffers: relevant,
+            sourceRange: sourceRange,
+            segmentCount: lastDecodedIndex - firstIndex + 1,
+            cacheWaitSeconds: cacheWaitSeconds,
+            decodeSeconds: decodeSeconds
+        )
+    }
+
+    private func waitForSegment(
+        _ index: Int,
+        deadline: Date
+    ) throws -> (data: Data, audioSourceShiftSeconds: Double?)? {
+        while Date() < deadline {
+            try Task.checkCancellation()
+            if let segment = cache.fetchForAudioAnalysis(
+                index: index,
+                timeout: min(0.25, remaining(until: deadline))
+            ) {
+                return segment
+            }
+        }
+        return nil
+    }
+
+    private func remaining(until deadline: Date) -> Double {
+        max(0.001, deadline.timeIntervalSinceNow)
+    }
+
+    private func coversRequestedEnd(_ buffers: [AudioTapBuffer]) -> Bool {
+        guard let last = buffers.last else { return false }
+        let end = last.sourceTime
+            + Double(last.buffer.frameLength)
+                / last.buffer.format.sampleRate
+        return end >= sourceRange.upperBound - 0.05
+    }
+
+    private func validateCoverage(_ buffers: [AudioTapBuffer]) throws {
+        let tolerance = 0.05
+        var coveredThrough = sourceRange.lowerBound
+        for (index, buffer) in buffers.enumerated() {
+            let start = buffer.sourceTime
+            let end = start + Double(buffer.buffer.frameLength)
+                / buffer.buffer.format.sampleRate
+            if index > 0, buffer.discontinuity {
+                throw AetherFingerprintAudioError.discontinuousRange
+            }
+            if start > coveredThrough + tolerance {
+                throw AetherFingerprintAudioError.discontinuousRange
+            }
+            coveredThrough = max(coveredThrough, end)
+            if coveredThrough >= sourceRange.upperBound - tolerance {
+                return
+            }
+        }
+        throw AetherFingerprintAudioError.incompleteRange
+    }
+}
+
+enum FingerprintAudioAxis {
+    static func itemRange(
+        for sourceRange: Range<Double>,
+        sourcePresentationOrigin: Double,
+        map: PresentationAxisMap
+    ) -> Range<Double>? {
+        let lowerSourcePTS = sourceRange.lowerBound + sourcePresentationOrigin
+        let upperSourcePTS = sourceRange.upperBound + sourcePresentationOrigin
+        guard let lower = map.itemSeconds(forSourceSeconds: lowerSourcePTS),
+              let upper = map.itemSeconds(forSourceSeconds: upperSourcePTS),
+              lower.isFinite,
+              upper.isFinite,
+              upper > lower else {
+            return nil
+        }
+        return lower..<upper
+    }
+}
+
+enum FingerprintAudioTimeline {
+    /// Fragment audio is muxed as `sourcePTS - audioSourceShift`; the public source axis is then
+    /// normalized by the host's presentation origin. Presentation-axis shifts select segments but
+    /// do not describe audio packet rebasing.
+    static func sourceTime(
+        decodedPTS: Double,
+        audioSourceShiftSeconds: Double,
+        sourcePresentationOrigin: Double
+    ) -> Double {
+        decodedPTS + audioSourceShiftSeconds - sourcePresentationOrigin
+    }
+}
+
+private final class FingerprintAudioCollector: @unchecked Sendable {
+    private let lock = NSLock()
+    private var buffers: [AudioTapBuffer] = []
+
+    func append(_ buffer: AudioTapBuffer) {
+        lock.lock()
+        buffers.append(buffer)
+        lock.unlock()
+    }
+
+    func snapshot() -> [AudioTapBuffer] {
+        lock.lock()
+        defer { lock.unlock() }
+        return buffers
+    }
+}
