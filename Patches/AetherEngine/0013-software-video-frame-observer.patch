--- /dev/null
+++ b/Sources/AetherEngine/SoftwareVideoFrame.swift
@@ -0,0 +1,22 @@
+import CoreMedia
+import CoreVideo
+
+/// An immutable picture handed to the software renderer after presentation reordering and seek
+/// filtering. Retaining the value retains its pixel buffer; a consumer must release obsolete frames
+/// and must never write the pixels or attachments. The renderer and audio keep their original clock.
+public struct SoftwareVideoFrame: @unchecked Sendable {
+    public let pixelBuffer: CVPixelBuffer
+    /// Source-axis PTS, using softwarePresentationTimebase and the subtitle cue axis.
+    public let presentation: CMTime
+    /// Process-wide renderer flush generation, with the same semantics as SoftwareVideoFrameTime.
+    public let generation: UInt64
+
+    public init(pixelBuffer: CVPixelBuffer, presentation: CMTime, generation: UInt64) {
+        self.pixelBuffer = pixelBuffer
+        self.presentation = presentation
+        self.generation = generation
+    }
+}
+
+/// Called on the decode thread, with no renderer lock held. Must not block or mutate the picture.
+public typealias SoftwareVideoFrameObserver = @Sendable (SoftwareVideoFrame) -> Void
diff --git a/Tests/AetherEngineTests/SoftwareVideoFrameObserverTests.swift b/Tests/AetherEngineTests/SoftwareVideoFrameObserverTests.swift
new file mode 100644
index 00000000..0e8b7ac1
--- /dev/null
+++ b/Tests/AetherEngineTests/SoftwareVideoFrameObserverTests.swift
@@ -0,0 +1,95 @@
+import AVFoundation
+import Foundation
+import Testing
+@testable import AetherEngine
+
+@Suite("Immutable software video frame observer")
+struct SoftwareVideoFrameObserverTests {
+    private final class Collector: @unchecked Sendable {
+        private let lock = NSLock()
+        private var storage: [SoftwareVideoFrame] = []
+        var values: [SoftwareVideoFrame] {
+            lock.lock(); defer { lock.unlock() }
+            return storage
+        }
+        func append(_ frame: SoftwareVideoFrame) {
+            lock.lock(); defer { lock.unlock() }
+            storage.append(frame)
+        }
+    }
+
+    private func picture() -> CVPixelBuffer {
+        var buffer: CVPixelBuffer?
+        CVPixelBufferCreate(kCFAllocatorDefault, 16, 16, kCVPixelFormatType_32BGRA, nil, &buffer)
+        return buffer!
+    }
+
+    private func time(_ seconds: Double) -> CMTime { CMTime(seconds: seconds, preferredTimescale: 600) }
+
+    @Test("observes the original decoded buffers in presentation order")
+    @MainActor
+    func orderedPictures() {
+        let renderer = SampleBufferRenderer()
+        let seen = Collector()
+        renderer.setVideoFrameObserver { seen.append($0) }
+        let times = [0.00, 0.12, 0.04, 0.08, 0.20, 0.16]
+        let pictures = times.map { _ in picture() }
+        for (seconds, pixelBuffer) in zip(times, pictures) {
+            renderer.enqueue(pixelBuffer: pixelBuffer, pts: time(seconds))
+        }
+        renderer.drainReorderBuffer()
+        #expect(seen.values.map { $0.presentation.seconds } == times.sorted())
+        for frame in seen.values {
+            let index = times.firstIndex(of: frame.presentation.seconds)!
+            #expect(frame.pixelBuffer === pictures[index])
+            #expect(frame.generation == renderer.flushGeneration)
+        }
+    }
+
+    @Test("invalid timestamps and pre-target seek frames never reach the pixel observer")
+    @MainActor
+    func filteredPictures() {
+        let renderer = SampleBufferRenderer()
+        let seen = Collector()
+        renderer.setVideoFrameObserver { seen.append($0) }
+        renderer.setSkipThreshold(time(10))
+        renderer.enqueue(pixelBuffer: picture(), pts: .invalid)
+        for seconds in [9.0, 9.5, 10.0] {
+            renderer.enqueue(pixelBuffer: picture(), pts: time(seconds))
+        }
+        renderer.drainReorderBuffer()
+        #expect(seen.values.map { $0.presentation.seconds } == [10.0])
+    }
+
+    @Test("flush generations separate identical timestamps and removing the observer stops delivery")
+    @MainActor
+    func generationAndRemoval() {
+        let renderer = SampleBufferRenderer()
+        let seen = Collector()
+        renderer.setVideoFrameObserver { seen.append($0) }
+        renderer.enqueue(pixelBuffer: picture(), pts: time(30))
+        renderer.drainReorderBuffer()
+        renderer.flush(removingDisplayedImage: false)
+        renderer.enqueue(pixelBuffer: picture(), pts: time(30))
+        renderer.drainReorderBuffer()
+        #expect(seen.values.count == 2)
+        #expect(seen.values[1].generation > seen.values[0].generation)
+        renderer.setVideoFrameObserver(nil)
+        renderer.enqueue(pixelBuffer: picture(), pts: time(31))
+        renderer.drainReorderBuffer()
+        #expect(seen.values.count == 2)
+    }
+
+    @Test("the engine stores and removes the pixel observer independently of the time observer")
+    @MainActor
+    func installation() throws {
+        let engine = try AetherEngine()
+        engine.setSoftwareVideoFrameTimeObserver { _ in }
+        engine.setSoftwareVideoFrameObserver { _ in }
+        #expect(engine.softwareVideoFrameObserver != nil)
+        engine.setSoftwareVideoFrameObserver(nil)
+        #expect(engine.softwareVideoFrameObserver == nil)
+        #expect(engine.softwareVideoFrameTimeObserver != nil)
+        engine.setSoftwareVideoFrameTimeObserver(nil)
+    }
+}
