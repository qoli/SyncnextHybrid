diff --git a/Sources/AetherEngine/Network/HLSHTTP1Client.swift b/Sources/AetherEngine/Network/HLSHTTP1Client.swift
new file mode 100644
index 00000000..5cbf55c6
--- /dev/null
+++ b/Sources/AetherEngine/Network/HLSHTTP1Client.swift
@@ -0,0 +1,112 @@
+import Foundation
+
+/// Per-playback HTTP/1.1 networking for HLS. It inherits the host's default
+/// Network privacy context, uses system TLS/EngineTLS trust, and never retries
+/// a refused connection through a different HTTP version or transport.
+public final class HLSHTTP1Client: @unchecked Sendable {
+    private let lock = NSLock()
+    private var idle: [String: [PersistentHTTP1Session]] = [:]
+    private var active: [ObjectIdentifier: PersistentHTTP1Session] = [:]
+    private var stopped = false
+
+    public init() {}
+    deinit { cancel() }
+
+    /// Cancels outstanding transfers and closes the playback's persistent connections.
+    public func cancel() {
+        lock.lock()
+        stopped = true
+        let sessions = idle.values.flatMap { $0 } + Array(active.values)
+        idle.removeAll()
+        active.removeAll()
+        lock.unlock()
+        sessions.forEach { $0.cancel() }
+    }
+
+    /// A bounded body, or a bounded prefix when an admission probe will stop early.
+    public func data(for request: URLRequest, limit: Int, prefix: Bool = false) async throws
+        -> (Data, HTTPURLResponse)
+    {
+        guard limit >= 0 else { throw BodyLimitExceeded(limit: limit) }
+        let body = Body(limit: limit, prefix: prefix)
+        do {
+            let result = try await stream(for: request, limit: prefix ? Int.max : limit,
+                receiveResponse: { response in
+                    body.setResponse(response)
+                    return (200..<300).contains(response.statusCode)
+                }, receive: { try body.append($0) })
+            return (body.data, result)
+        } catch is PrefixComplete {
+            guard let response = body.response else { throw URLError(.badServerResponse) }
+            return (body.data, response)
+        } catch PersistentHTTP1Session.TransferError.bodyExceedsLimit {
+            throw BodyLimitExceeded(limit: limit)
+        }
+    }
+
+    public struct BodyLimitExceeded: Error, Sendable { public let limit: Int }
+
+    /// Delivers headers before incrementally delivering body chunks. A false
+    /// response verdict closes that request without downloading its body.
+    @discardableResult
+    public func stream(
+        for request: URLRequest,
+        limit: Int,
+        receiveResponse: @escaping @Sendable (HTTPURLResponse) throws -> Bool,
+        receive: @escaping @Sendable (Data) throws -> Void
+    ) async throws -> HTTPURLResponse {
+        try Task.checkCancellation()
+        guard request.httpMethod == nil || request.httpMethod == "GET",
+              let url = request.url, let host = url.host,
+              let scheme = url.scheme, ["http", "https"].contains(scheme),
+              (1...65535).contains(url.port ?? (scheme == "https" ? 443 : 80)) else {
+            throw URLError(.unsupportedURL)
+        }
+        let key = "\(scheme)://\(host):\(url.port ?? (scheme == "https" ? 443 : 80))"
+        let session = try acquire(key)
+        defer { release(session, key: key) }
+        let result = try await session.stream(
+            for: request, limit: limit, receiveResponse: receiveResponse, receive: receive)
+        EngineLog.remoteHLSRouteObserver?(
+            "event=hls-http1-transfer outcome=completed host=\(result.url.host ?? "unknown") "
+                + "http_protocol=http/1.1 connection_reused=\(result.reusedConnection) "
+                + "status=\(result.statusCode) bytes=\(result.byteCount)")
+        return result.response
+    }
+
+    private func acquire(_ key: String) throws -> PersistentHTTP1Session {
+        lock.lock(); defer { lock.unlock() }
+        guard !stopped else { throw CancellationError() }
+        let session = idle[key]?.popLast() ?? PersistentHTTP1Session(usesNetworkFramework: true)
+        active[ObjectIdentifier(session)] = session
+        return session
+    }
+
+    private func release(_ session: PersistentHTTP1Session, key: String) {
+        lock.lock()
+        active.removeValue(forKey: ObjectIdentifier(session))
+        if !stopped && !session.isCancelled { idle[key, default: []].append(session) }
+        lock.unlock()
+    }
+
+    private struct PrefixComplete: Error {}
+    private final class Body: @unchecked Sendable {
+        let limit: Int
+        let prefix: Bool
+        // Only the serial transfer worker writes; the awaiting caller reads
+        // after its continuation has completed.
+        private(set) var data = Data()
+        private(set) var response: HTTPURLResponse?
+        init(limit: Int, prefix: Bool) { self.limit = limit; self.prefix = prefix }
+        func setResponse(_ response: HTTPURLResponse) { self.response = response }
+        func append(_ bytes: Data) throws {
+            if prefix {
+                data.append(bytes.prefix(max(0, limit - data.count)))
+                if data.count == limit { throw PrefixComplete() }
+            } else {
+                guard bytes.count <= limit - data.count else { throw BodyLimitExceeded(limit: limit) }
+                data.append(bytes)
+            }
+        }
+    }
+}
