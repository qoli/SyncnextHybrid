new file mode 100644
index 00000000..2a39cb57
--- /dev/null
+++ b/Sources/AetherEngine/Network/HLSHTTP1Connection.swift
@@ -0,0 +1,150 @@
+import Foundation
+import Network
+import Security
+
+/// A TCP/TLS connection with no HTTP/2 or HTTP/3 negotiation. HTTP framing stays in
+/// PersistentHTTP1Session. The default privacy context is the host's DNS policy.
+final class HLSHTTP1Connection: @unchecked Sendable {
+    private let connection: NWConnection
+    private let queue = DispatchQueue(label: "aether.hls.http1.connection")
+    private let host: String
+    private let trustState: TrustState
+    // Reads are serialized by the HTTP/1.1 framing owner. Network may deliver
+    // its final nonempty bytes together with EOF; a later receive is ENODATA.
+    private var reachedEOF = false
+
+    init(host: String, port: Int, secure: Bool) {
+        self.host = host
+        let trustState = TrustState()
+        self.trustState = trustState
+        let tls: NWProtocolTLS.Options? = secure ? NWProtocolTLS.Options() : nil
+        if let tls {
+            sec_protocol_options_set_tls_server_name(tls.securityProtocolOptions, host)
+            sec_protocol_options_set_verify_block(tls.securityProtocolOptions, { _, trust, complete in
+                let trust = sec_trust_copy_ref(trust).takeRetainedValue()
+                let space = HTTP1ProtectionSpace(host: host, port: port, trust: trust)
+                let accepted = EngineTLS.serverTrustEvaluator?(space) == true
+                    || SecTrustEvaluateWithError(trust, nil)
+                trustState.setRefused(!accepted)
+                complete(accepted)
+            }, queue)
+        }
+        let parameters = NWParameters(tls: tls, tcp: NWProtocolTCP.Options())
+        // Connections inherit PrivacyContext.default. Do not explicitly attach
+        // the process-default context as a separate per-connection context.
+        connection = NWConnection(host: NWEndpoint.Host(host), port: NWEndpoint.Port(rawValue: UInt16(port))!, using: parameters)
+    }
+
+    func open(timeout: TimeInterval) throws {
+        let ready = Completion<Void>()
+        connection.stateUpdateHandler = { [weak self] state in
+            switch state {
+            case .ready:
+                self?.reportResolution()
+                ready.finish(.success(()))
+            case .failed(let error), .waiting(let error): ready.finish(.failure(error))
+            case .cancelled: ready.finish(.failure(CancellationError()))
+            default: break
+            }
+        }
+        connection.start(queue: queue)
+        do { try ready.wait(timeout: timeout) }
+        catch {
+            cancel()
+            if trustState.refused { throw URLError(.serverCertificateUntrusted) }
+            throw error
+        }
+    }
+
+    func write(_ data: Data, timeout: TimeInterval) throws {
+        let result = Completion<Void>()
+        connection.send(content: data, completion: .contentProcessed { error in
+            result.finish(error.map { .failure($0) } ?? .success(()))
+        })
+        do { try result.wait(timeout: timeout) }
+        catch { cancel(); throw error }
+    }
+
+    func read(maxLength: Int, timeout: TimeInterval) throws -> (Data, Bool) {
+        if reachedEOF { return (Data(), true) }
+        let result = Completion<(Data, Bool)>()
+        connection.receive(minimumIncompleteLength: 1, maximumLength: maxLength) { data, _, eof, error in
+            result.finish(error.map { .failure($0) } ?? .success((data ?? Data(), eof)))
+        }
+        do {
+            let value = try result.wait(timeout: timeout)
+            reachedEOF = value.1
+            return value
+        }
+        catch { cancel(); throw error }
+    }
+
+    func cancel() { connection.cancel() }
+
+    private func reportResolution() {
+        let host = host
+        connection.requestEstablishmentReport(queue: queue) { report in
+            guard let resolutions = report?.resolutions, !resolutions.isEmpty else {
+                EngineLog.remoteHLSRouteObserver?(
+                    "event=connection stage=hls-http1 host=\(host) http_protocol=http/1.1 "
+                        + "dns_protocol=unknown evidence=unconfirmed source=connection-establishment")
+                return
+            }
+            for resolution in resolutions {
+                let dns: String
+                let evidence: String
+                switch resolution.dnsProtocol {
+                case .https: (dns, evidence) = ("https", "encrypted")
+                case .tls: (dns, evidence) = ("tls", "encrypted")
+                case .udp: (dns, evidence) = ("udp", "cleartext")
+                case .tcp: (dns, evidence) = ("tcp", "cleartext")
+                case .unknown: (dns, evidence) = ("unknown", "unconfirmed")
+                @unknown default: (dns, evidence) = ("unknown", "unconfirmed")
+                }
+                EngineLog.remoteHLSRouteObserver?(
+                    "event=connection stage=hls-http1 host=\(host) http_protocol=http/1.1 "
+                        + "dns_protocol=\(dns) evidence=\(evidence) "
+                        + "resolution_source=\(resolution.source) source=connection-establishment")
+            }
+        }
+    }
+
+    private final class Completion<Value: Sendable>: @unchecked Sendable {
+        private let lock = NSLock()
+        private let semaphore = DispatchSemaphore(value: 0)
+        private var result: Result<Value, Error>?
+        func finish(_ result: Result<Value, Error>) {
+            lock.lock()
+            guard self.result == nil else { lock.unlock(); return }
+            self.result = result
+            lock.unlock()
+            semaphore.signal()
+        }
+        func wait(timeout: TimeInterval) throws -> Value {
+            guard semaphore.wait(timeout: .now() + timeout) == .success else {
+                throw URLError(.timedOut)
+            }
+            lock.lock(); defer { lock.unlock() }
+            return try result!.get()
+        }
+    }
+
+    private final class TrustState: @unchecked Sendable {
+        private let lock = NSLock()
+        private var value = false
+        var refused: Bool { lock.lock(); defer { lock.unlock() }; return value }
+        func setRefused(_ value: Bool) { lock.lock(); self.value = value; lock.unlock() }
+    }
+}
+
+/// Keeps the existing EngineTLS hook's real SecTrust available to pinning hosts.
+private final class HTTP1ProtectionSpace: URLProtectionSpace, @unchecked Sendable {
+    private let trust: SecTrust
+    init(host: String, port: Int, trust: SecTrust) {
+        self.trust = trust
+        super.init(host: host, port: port, protocol: "https", realm: nil,
+                   authenticationMethod: NSURLAuthenticationMethodServerTrust)
+    }
+    required init?(coder: NSCoder) { nil }
+    override var serverTrust: SecTrust? { trust }
+}
