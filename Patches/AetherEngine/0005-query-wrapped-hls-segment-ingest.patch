+            reused = true
+        } else {
+            closeSocket()
+            let configuration = URLSessionConfiguration.ephemeral
+            configuration.timeoutIntervalForRequest = Self.readTimeout
+            configuration.timeoutIntervalForResource = .greatestFiniteMagnitude
