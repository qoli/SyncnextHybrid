+    /// Feed each segment needed by a query-wrapper seek to FFmpeg as bytes arrive. Waiting for a
+    /// complete segment recreates the same long startup stall as the rejected FFmpeg HLS request, and
+    /// parallel full-body fetches can make every request miss the resource timeout. Every response is
+    /// still bounded and format-checked before its first chunk crosses the reader boundary.
+    private func streamSegment(_ url: URL, limit: Int, generation: UInt64) async throws {
+        let (bytes, response) = try await session.bytes(for: makeRequest(url))
+        defer { bytes.task.cancel() }
+        let status = (response as? HTTPURLResponse)?.statusCode ?? -1
+        guard (200..<300).contains(status) else {
+            throw HLSIngestError.playlistUnreachable(status: status)
+        }
+        let declared = response.expectedContentLength
+        guard declared <= Int64(limit) else {
+            throw HLSIngestError.playlistInvalid(reason: "body exceeds \(limit) bytes")
+        }
+
+        let chunkLimit = 64 * 1024
+        var chunk = Data()
+        chunk.reserveCapacity(chunkLimit)
+        var received = 0
+        var classified = false
+        for try await byte in bytes {
+            try Task.checkCancellation()
+            received += 1
+            guard received <= limit else {
+                throw HLSIngestError.playlistInvalid(reason: "body exceeds \(limit) bytes")
+            }
+            chunk.append(byte)
+            if !classified, chunk.count >= 3 {
+                guard LiveSegmentFormat.classify(chunk) == .mpegts else {
+                    throw HLSIngestError.unsupportedSegmentFormat
+                }
+                classified = true
+            }
+            if classified, chunk.count >= chunkLimit {
+                guard append(chunk, generation: generation) else { return }
+                chunk.removeAll(keepingCapacity: true)
+            }
+        }
+        guard received > 0, classified else {
+            throw HLSIngestError.unsupportedSegmentFormat
+        }
+        if !chunk.isEmpty {
+            _ = append(chunk, generation: generation)
+        }
+    }
