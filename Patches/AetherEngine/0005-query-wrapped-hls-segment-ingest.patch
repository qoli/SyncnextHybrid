+        try write(HeldSourceConnection.requestBytes(
+            target: target,
+            host: host,
+            port: requestedOrigin.port,
+            secure: secure,
+            offset: nil,
+            extraHeaders: headers,
+            userAgent: nil
+        ))
+        return (try readHead(), reused)
+    }
+
+    private func pump(
+        framing: HeldSourceConnection.BodyFraming,
+        limit: Int,
+        receive: @escaping @Sendable (Data) throws -> Void
+    ) throws -> Int {
+        var framing = framing
+        var received = 0
+        while true {
+            if isCancelled { throw CancellationError() }
+            let data: Data?
+            switch framing {
+            case .identity(let remaining):
+                if remaining == 0 { return received }
+                guard let next = try readBody(upTo: Int(min(Int64(Self.readChunkBytes), remaining))) else {
+                    throw TransferError.truncatedBody
+                }
+                framing = .identity(remaining: remaining - Int64(next.count))
+                data = next
+            case .chunked(let decoder):
+                if let next = try decoder.take(upTo: Self.readChunkBytes) {
+                    data = next
+                } else if decoder.isComplete {
+                    return received
+                } else {
+                    guard let wire = try readBody(upTo: Self.readChunkBytes) else {
+                        throw TransferError.malformedResponse("connection closed inside a chunked body")
+                    }
+                    decoder.feed(wire)
+                    continue
+                }
+            case .untilClose:
+                guard let next = try readBody(upTo: Self.readChunkBytes) else {
+                    return received
+                }
+                data = next
+            }
