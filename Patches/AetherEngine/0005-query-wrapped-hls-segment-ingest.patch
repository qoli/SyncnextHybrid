+    func testQueryWrappedHEVCSegmentBuildsTheNarrowPreflightReader() async throws {
+        let root = try XCTUnwrap(URL(string: "https://vod.test/media.m3u8?token=fixture"))
+        let segment = try XCTUnwrap(URL(
+            string: "https://vod.test/api/ts?url=https%3A%2F%2Fedge.test%2Fsegment.ts"
+        ))
+        Issue268URLProtocol.bodyByURL[root.absoluteString] = mediaPlaylist(segment.absoluteString)
+        Issue268URLProtocol.bodyByURL[segment.absoluteString] = transportStream(streamType: 0x24)
+
+        let session = makeSession()
+        defer { session.invalidateAndCancel() }
+        let reader = try await HLSVODIngestReader.makeIfQueryWrappedHEVCMPEGTS(
+            playlistURL: root,
+            httpHeaders: ["User-Agent": "fixture-agent"],
+            session: session
+        )
+        let admitted = try XCTUnwrap(reader)
+        defer { admitted.close() }
+
+        var bytes = [UInt8](repeating: 0, count: 188)
+        let count = bytes.withUnsafeMutableBufferPointer {
+            admitted.read($0.baseAddress, size: Int32($0.count))
+        }
+        XCTAssertEqual(count, 188)
+        XCTAssertEqual(bytes[0], 0x47)
+        XCTAssertEqual(
+            Issue268URLProtocol.headersByURL[segment.absoluteString]?["User-Agent"],
+            "fixture-agent"
+        )
+    }
+
+    func testQueryWrappedReaderDeliversBeforeTheWholeSegmentFinishes() async throws {
+        let root = try XCTUnwrap(URL(string: "https://vod.test/streaming.m3u8"))
+        let segment = try XCTUnwrap(URL(
+            string: "https://vod.test/api/ts?url=https%3A%2F%2Fedge.test%2Fstreaming.ts"
+        ))
+        Issue268URLProtocol.bodyByURL[root.absoluteString] = mediaPlaylist(segment.absoluteString)
+        var body = transportStream(streamType: 0x24)
+        body.append(Data(repeating: 0xFF, count: 128 * 1024))
+        Issue268URLProtocol.bodyByURL[segment.absoluteString] = body
+        let tailGate = DispatchSemaphore(value: 0)
+        Issue268URLProtocol.streamTailGateByURL[segment.absoluteString] = tailGate
+
+        let session = makeSession()
+        defer { session.invalidateAndCancel() }
+        let made = try await HLSVODIngestReader.makeIfQueryWrappedHEVCMPEGTS(
+            playlistURL: root,
+            httpHeaders: [:],
+            session: session
+        )
+        let reader = try XCTUnwrap(made)
+        defer {
+            tailGate.signal()
+            reader.close()
+        }
+
+        var bytes = [UInt8](repeating: 0, count: 188)
+        let readStartedAt = Date.timeIntervalSinceReferenceDate
+        let count = bytes.withUnsafeMutableBufferPointer {
+            reader.read($0.baseAddress, size: Int32($0.count))
+        }
+        let readElapsed = Date.timeIntervalSinceReferenceDate - readStartedAt
+
+        XCTAssertEqual(count, 188)
+        XCTAssertEqual(bytes[0], 0x47)
+        XCTAssertLessThan(
+            readElapsed,
+            1,
+            "the query-wrapper ingest must release bounded chunks before the response tail arrives"
+        )
+    }
+
