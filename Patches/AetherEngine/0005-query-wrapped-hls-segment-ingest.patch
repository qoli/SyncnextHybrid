+                    url: target,
+                    statusCode: head.status,
+                    byteCount: count,
+                    reusedConnection: reused
+                )
+            }
+        } catch {
+            closeSocket()
+            throw error
+        }
+    }
+
+    private static func canReuse(
+        head: HeldSourceConnection.ResponseHead,
+        framing: HeldSourceConnection.BodyFraming
