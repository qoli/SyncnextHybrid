+    /// shared by the entire segment sequence, so this method never opens, retries or falls back on
+    /// its own. A refusal from the wrapper remains the terminal failure it actually was.
+    private func streamSegment(
+        _ url: URL,
+        limit: Int,
+        generation: UInt64,
+        transport: PersistentHTTP1Session
+    ) async throws {
+        let startedAt = Date.timeIntervalSinceReferenceDate
+        let resource = url.lastPathComponent
+        EngineLog.emit(
+            "[HLSVODIngest] query-wrapper fetch_started resource=\(resource) "
+                + "api=persistent_http1 protocol=http/1.1",
+            category: .engine
+        )
+        let sink = QueryWrappedSegmentSink(reader: self, generation: generation)
+        do {
+            let result = try await transport.stream(
+                for: makeRequest(url),
+                limit: limit,
+                cancelSessionOnTaskCancellation: false,
+                receive: { try sink.receive($0) }
+            )
+            try sink.finish()
+            let elapsed = Date.timeIntervalSinceReferenceDate - startedAt
+            EngineLog.emit(
+                String(
+                    format: "[HLSVODIngest] query-wrapper fetch_finished resource=%@ "
+                        + "api=persistent_http1 protocol=http/1.1 connectionReused=%@ "
+                        + "status=%d bytes=%d elapsed=%.3fs",
+                    resource,
+                    result.reusedConnection ? "true" : "false",
+                    result.statusCode,
+                    result.byteCount,
+                    elapsed
+                ),
+                category: .engine
+            )
+        } catch let error as PersistentHTTP1Session.TransferError {
+            let elapsed = Date.timeIntervalSinceReferenceDate - startedAt
+            EngineLog.emit(
+                String(
+                    format: "[HLSVODIngest] query-wrapper fetch_failed resource=%@ "
+                        + "api=persistent_http1 protocol=http/1.1 elapsed=%.3fs error=%@",
+                    resource,
+                    elapsed,
+                    EngineLog.summary(of: error)
+                ),
+                category: .engine
+            )
+            switch error {
+            case .httpStatus(let status):
+                throw HLSIngestError.playlistUnreachable(status: status)
+            case .bodyExceedsLimit(let limit):
+                throw HLSIngestError.playlistInvalid(reason: "body exceeds \(limit) bytes")
+            default:
+                throw error
+            }
+        }
+    }
+
+    /// Mutable segment state lives in this serial sink instead of in an escaping `@Sendable`
+    /// closure. The HTTP/1.1 session calls it on its private queue, one body chunk at a time.
+    private final class QueryWrappedSegmentSink: @unchecked Sendable {
+        private unowned let reader: HLSVODIngestReader
+        private let generation: UInt64
+        private var prefix = Data()
+        private var received = 0
+        private var classified = false
+        private var discarding = false
+
+        init(reader: HLSVODIngestReader, generation: UInt64) {
+            self.reader = reader
+            self.generation = generation
+            prefix.reserveCapacity(3)
+        }
+
+        func receive(_ data: Data) throws {
+            received += data.count
+            if !classified {
+                prefix.append(data)
+                guard prefix.count >= 3 else { return }
+                guard LiveSegmentFormat.classify(prefix) == .mpegts else {
+                    throw HLSIngestError.unsupportedSegmentFormat
+                }
+                classified = true
+                guard reader.append(prefix, generation: generation) else {
+                    discarding = true
+                    prefix.removeAll(keepingCapacity: false)
+                    return
+                }
+                prefix.removeAll(keepingCapacity: false)
+                return
+            }
+            if !discarding, !reader.append(data, generation: generation) {
+                discarding = true
+            }
+        }
+
+        func finish() throws {
+            guard received > 0, classified else {
+                throw HLSIngestError.unsupportedSegmentFormat
+            }
+        }
+    }
+
     private func append(_ data: Data, generation: UInt64) -> Bool {
         condition.lock()
         defer { condition.unlock() }
