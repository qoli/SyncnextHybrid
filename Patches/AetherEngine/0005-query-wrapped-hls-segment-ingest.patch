+/// A bounded HTTP/1.1 session for the finite query-wrapped HLS path.
+///
+/// Some query-wrapper origins bind consecutive segment authorizations to one HTTP/1.1 connection.
+/// Issuing one Foundation request per segment can negotiate HTTP/2 and, even when requests are made
+/// serially, replaces the connection between segments. This transport keeps exactly one connection
+/// for same-origin requests and never retries a refused request on another protocol or socket.
+final class PersistentHTTP1Session: @unchecked Sendable {
+    struct Result: Sendable {
+        let url: URL
+        let statusCode: Int
+        let byteCount: Int
+        let reusedConnection: Bool
+    }
+
+    enum TransferError: LocalizedError, Equatable {
+        case bodyExceedsLimit(Int)
+        case httpStatus(Int)
+        case malformedResponse(String)
+        case tooManyRedirects
+        case truncatedBody
+        case unsupportedURL(URL)
+
+        var errorDescription: String? {
+            switch self {
+            case .bodyExceedsLimit(let limit): return "body exceeds \(limit) bytes"
+            case .httpStatus(let status): return "HTTP status \(status)"
+            case .malformedResponse(let detail): return "malformed HTTP response: \(detail)"
+            case .tooManyRedirects: return "too many redirects"
+            case .truncatedBody: return "connection closed before Content-Length bytes arrived"
+            case .unsupportedURL(let url): return "unsupported URL for HTTP/1.1 session: \(url)"
+            }
+        }
+    }
+
+    private struct Origin: Equatable {
+        let scheme: String
+        let host: String
+        let port: Int
+
+        init?(_ url: URL) {
+            guard let scheme = url.scheme?.lowercased(),
+                  scheme == "http" || scheme == "https",
+                  let host = url.host?.lowercased() else { return nil }
+            self.scheme = scheme
+            self.host = host
+            self.port = url.port ?? (scheme == "https" ? 443 : 80)
+        }
+    }
+
+    private static let maxHeadBytes = 128 * 1024
+    private static let maxRedirects = 3
+    private static let readChunkBytes = 64 * 1024
+    private static let readTimeout: TimeInterval = 30
+    private static let writeTimeout: TimeInterval = 20
+
+    private let queue = DispatchQueue(label: "aether.hls.query-wrapped.http1")
+    private let stateLock = NSLock()
+    private var _cancelled = false
+    private var session: URLSession?
+    private var task: URLSessionStreamTask?
+    private var origin: Origin?
+    private var pending = Data()
+
+    deinit { cancel() }
+
+    var isCancelled: Bool {
+        stateLock.lock(); defer { stateLock.unlock() }
+        return _cancelled
+    }
+
+    /// Streams one complete response body while enforcing its byte ceiling. Calls made one after
+    /// another on the same origin reuse this object's socket. A cancellation permanently ends the
+    /// session so a superseded HLS generation cannot reopen behind its caller's back.
+    func stream(
+        for request: URLRequest,
+        limit: Int,
+        cancelSessionOnTaskCancellation: Bool = true,
+        receive: @escaping @Sendable (Data) throws -> Void
+    ) async throws -> Result {
+        try Task.checkCancellation()
+        let result = try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                queue.async { [self] in
+                    do {
+                        continuation.resume(returning: try perform(
+                            request: request,
+                            limit: limit,
+                            receive: receive
+                        ))
+                    } catch {
+                        continuation.resume(throwing: isCancelled ? CancellationError() : error)
+                    }
+                }
+            }
+        } onCancel: { [self] in
+            if cancelSessionOnTaskCancellation { cancel() }
+        }
+        // A reader-generation cancellation may deliberately drain the current response so the
+        // next generation can keep the same socket. The canceled caller still observes
+        // CancellationError, but only after the framing boundary has made reuse safe.
+        if !cancelSessionOnTaskCancellation { try Task.checkCancellation() }
+        return result
+    }
+
+    func cancel() {
+        stateLock.lock()
+        if _cancelled {
+            stateLock.unlock()
+            return
+        }
+        _cancelled = true
+        let task = self.task
+        let session = self.session
+        self.task = nil
+        self.session = nil
+        origin = nil
+        pending = Data()
+        stateLock.unlock()
+        task?.closeRead()
+        task?.closeWrite()
+        session?.invalidateAndCancel()
+    }
+
+    private func perform(
+        request: URLRequest,
+        limit: Int,
+        receive: @escaping @Sendable (Data) throws -> Void
