+    }
+
+    private func openOrReuse(
+        _ target: URL,
+        headers: [String: String]
+    ) throws -> (HeldSourceConnection.ResponseHead, Bool) {
+        guard let requestedOrigin = Origin(target), let host = target.host else {
+            throw TransferError.unsupportedURL(target)
